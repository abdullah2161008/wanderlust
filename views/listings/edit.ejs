<% layout("/layouts/boilerplate.ejs") %>

<div class="form-container">
    <h2>Edit Listing</h2>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

        <div class="form-group">
            <label for="title">Title</label>
            <input required type="text" name="title" id="title" value="<%= listing.title %>">
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea required name="description" id="description"><%= listing.description %></textarea>
        </div>

        <div class="form-group">
            <label for="image">Image URL</label>
            <input type="url" name="image" id="image" value="<%= listing.image %>" oninput="previewImage(this.value)">
        </div>

        <!-- Image Preview -->
        <div class="form-group">
            <label>Image Preview</label>
            <div class="image-preview-box">
                <img id="imagePreview" src="<%= listing.image %>" alt="Preview" onerror="this.src='https://via.placeholder.com/600x300?text=Invalid+URL'" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="price">Price per Night</label>
                <input required type="number" name="price" id="price" value="<%= listing.price %>">
            </div>
            <div class="form-group">
                <label for="location">Location</label>
                <input required type="text" name="location" id="location" value="<%= listing.location %>">
            </div>
        </div>

        <div class="form-group">
            <label for="country">Country</label>
            <input required type="text" name="country" id="country" value="<%= listing.country %>">
        </div>

        <div class="form-btns">
            <a href="/listings/<%= listing._id %>" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>

    </form>
</div>

<script>
    function previewImage(url) {
        const preview = document.getElementById("imagePreview");
        preview.src = url || "https://via.placeholder.com/600x300?text=Enter+Image+URL";
        preview.onerror = function() {
            this.src = "https://via.placeholder.com/600x300?text=Invalid+URL";
        };
    }
</script>
