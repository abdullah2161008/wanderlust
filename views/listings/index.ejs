<% layout("/layouts/boilerplate.ejs") %>


<div class="flash-container">
    <% if (success && success.length > 0) { %>
        <div class="flash-msg flash-success">
            <span class="flash-icon">✓</span>
            <%= success %>
            <button class="flash-close" onclick="this.parentElement.style.display='none'">&times;</button>
        </div>
    <% } %>

    <% if (signUpDone && signUpDone.length > 0) { %>
        <div class="flash-msg flash-login">
            <span class="flash-icon">✓</span>
            <%= signUpDone %>
            <button class="flash-close" onclick="this.parentElement.style.display='none'">&times;</button>
        </div>
    <% } %>

    <% if (listingDel && listingDel.length > 0) { %>
        <div class="flash-msg flash-delete">
            <span class="flash-icon">🗑</span>
            <%= listingDel %>
            <button class="flash-close" onclick="this.parentElement.style.display='none'">&times;</button>
        </div>
    <% } %>
    

    <% if (listingEdit && listingEdit.length > 0) { %>
        <div class="flash-msg flash-edit">
            <span class="flash-icon">✎</span>
            <%= listingEdit %>
            <button class="flash-close" onclick="this.parentElement.style.display='none'">&times;</button>
        </div>
    <% } %>
</div>

<div class="listings-header">
    <h2>Explore Listings</h2>
    <a href="/listings/new" class="btn btn-primary">+ Add Listing</a>
</div>

<div class="listings-grid">
    <% for (let listing of allListings) { %>
        <div class="listing-card">
            <a href="/listings/<%= listing._id %>">
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" />
            </a>
            <div class="listing-card-body">
                <h3><%= listing.title %></h3>
                <p><%= listing.location %>, <%= listing.country %></p>
                <div class="listing-card-footer">
                    <span class="price">
                        <%= listing.price %> Rs <span>/ night</span>
                    </span>

                    <% if (typeof searchQuery !== "undefined" && searchQuery) { %>
                        <p class="search-results-info">
                            Showing results for "<%= searchQuery %>"
                            <% if (allListings.length === 0) { %> — no listings found.<% } %>
                        </p>
                    <% } %>
                    <% if(currentUser && listing.owner && listing.owner.equals(currentUser._id)) { %>
                    <div class="card-actions">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline">
                            Edit
                        </a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                <% } %>
                </div>
            </div>
        </div>
    <% } %>
</div>