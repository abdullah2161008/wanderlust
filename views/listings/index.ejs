<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3>All listings</h3>
    <button><a href="/listings/new">Create new Listing</a></button>
    <ul>
        <% for(let listing of  allListings){ %>
            <li><a href="/listings/<%= listing._id %>"><%= listing.title %></a> <button>
                <a href="/listings/<%= listing._id %>/edit">Edit</a></button> 
                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button>Delete</button>
                </form>
            </li>
            
        <% } %>
    </ul>
</body>
</html>

