<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    > -->
</head>
<body>
    <!-- HEADER -->
    <header>
        <div class="nav-inner">
            <a href="/listings" class="nav-logo">
                <div class="logo-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                </div>
                <span>WanderLust</span>
            </a>

            <div class="nav-search">
                <input type="text" placeholder="Search destinations..." />
                <button class="search-btn">
                    <svg viewBox="0 0 24 24" stroke-width="2.5">
                        <circle cx="11" cy="11" r="7"/>
                        <line x1="16.5" y1="16.5" x2="22" y2="22"/>
                    </svg>
                </button>
            </div>

            <nav class="nav-actions">
                <a href="/listings" class="nav-link">Explore</a>
                <a href="/listings/new" class="nav-link primary">+ Add Listing</a>
            </nav>
        </div>
    </header>

    <!-- Main CONTENT -->
    <main>
        <%- body %>
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="footer-inner">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4>Support</h4>
                    <ul>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Safety Info</a></li>
                        <li><a href="#">Cancellation Options</a></li>
                        <li><a href="#">Report a Concern</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Community</h4>
                    <ul>
                        <li><a href="#">WanderLust Blog</a></li>
                        <li><a href="#">Travel Tips</a></li>
                        <li><a href="#">Forum</a></li>
                        <li><a href="#">Refer a Host</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Hosting</h4>
                    <ul>
                        <li><a href="/listings/new">List Your Property</a></li>
                        <li><a href="#">Host Resources</a></li>
                        <li><a href="#">Community Forum</a></li>
                        <li><a href="#">Responsible Hosting</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>WanderLust</h4>
                    <ul>
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Press</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© 2025 <span>WanderLust</span> · All rights reserved</p>
                <div class="footer-socials">
                    <a href="#">Twitter</a>
                    <a href="#">Instagram</a>
                    <a href="#">Facebook</a>
                </div>
            </div>
        </div>
    </footer>
    <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script> -->
    <!-- <script src="public/js/script.js"></script> -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>
